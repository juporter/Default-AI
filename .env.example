# Copy this file to .env and fill in a key for each provider you want to use,
# or add them in the app under Settings → Import settings.
# Providers without a key are shown in the app but can't be selected.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
META_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
KIMI_API_KEY=

# --- Optional -------------------------------------------------------------

# Default model per provider. Any model your key can use also shows up in the
# app's model dropdown, which is loaded live from each provider.
# OPENAI_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=claude-opus-5-5
# META_MODEL=muse-spark-1.3
# GEMINI_MODEL=gemini-4-argon
# XAI_MODEL=grok-4.7
# DEEPSEEK_MODEL=deepseek-v4-pro
# PERPLEXITY_MODEL=perplexity/sonar
# KIMI_MODEL=kimi-k3.1-pro

# Point a provider at a different (compatible) endpoint, e.g. a proxy or
# gateway. META_BASE_URL can be any OpenAI-compatible host that serves Llama,
# such as https://api.groq.com/openai/v1 or https://api.together.xyz/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# META_BASE_URL=https://api.meta.ai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_BASE_URL=https://api.x.ai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PERPLEXITY_BASE_URL=https://api.perplexity.ai/v1
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Max output tokens for Claude (the Messages API requires a limit).
# MAX_TOKENS=4096

# How long to wait for each provider, in milliseconds.
# REQUEST_TIMEOUT_MS=120000

# --- Ads (Google AdSense) --------------------------------------------------
# AdSense only shows ads on a public site that Google has approved.
# ADSENSE_CLIENT=ca-pub-1234567890123456
# ADSENSE_SLOT_TOP=1234567890
# ADSENSE_SLOT_BOTTOM=1234567890
# Show empty, labelled ad boxes to preview the layout:
# ADS_PLACEHOLDER=true

# Where the app listens. Keep HOST on 127.0.0.1 unless you understand that
# anyone who can reach the port can spend your API credits.
# HOST=127.0.0.1
# PORT=3000
